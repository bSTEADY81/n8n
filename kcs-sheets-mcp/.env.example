# Long random string. Used both as the path secret (/mcp/<token>) and as the
# accepted bearer token. Generate with: openssl rand -hex 32
MCP_AUTH_TOKEN=

# Service account credentials. Either paste the whole downloaded key file...
GOOGLE_SERVICE_ACCOUNT_JSON=
# ...or split it into these two. GOOGLE_PRIVATE_KEY may contain literal \n.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=

# Drive folder ID for "Quotes 2026 S&I". Quote workbooks are admitted by parentage.
QUOTES_FOLDER_ID=

# Optional escape hatch: extra spreadsheet IDs to allow, comma separated.
EXTRA_SHEET_IDS=
